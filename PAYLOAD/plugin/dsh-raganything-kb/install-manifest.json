{
  "schema": 1,
  "bundle": "dsh-raganything-kb",
  "version": "0.5.0",
  "pluginId": "kb",
  "title": "AI 知识库",
  "requires": {
    "bundlesBefore": [],
    "hostServices": [
      "jobs",
      "llm",
      "systemPrompt",
      "webServer"
    ],
    "hostServicesSoft": [],
    "pluginsOptional": [
      "workbenchCapabilities"
    ]
  },
  "license": {
    "gateVersion": "1.2c",
    "gateMd5": "d27eff05335e9a57a976150865b73e7d",
    "httpMd5": "dd31ae47fce2740154cf3e6e5d6dfeec",
    "gatePaths": [
      "lib/license-gate.mjs",
      "lib/license-http.mjs"
    ],
    "panelMode": "none"
  },
  "runtime": {
    "node": ">=20",
    "python": {
      "min": "3.10",
      "pip": [
        "fastapi>=0.110",
        "uvicorn",
        "httpx",
        "numpy",
        "python-docx",
        "openpyxl",
        "python-pptx"
      ],
      "venv": "$DSH_HOME/.runtime/kb-venv"
    },
    "bins": [
      {
        "name": "python3",
        "required": true
      }
    ],
    "models": [],
    "services": []
  },
  "paths": {
    "dataDir": {
      "env": "DSH_HOME",
      "default": "$DSH_HOME/raganything"
    }
  },
  "enhancements": []
}
